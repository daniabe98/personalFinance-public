[Unit]
Description=Personal Finance verified daily backup

[Service]
Type=oneshot
User=personal-finance
Group=personal-finance
EnvironmentFile=/etc/personal-finance/personal-finance.env
WorkingDirectory=/var/lib/personal-finance
ExecStart=/opt/personal-finance/bin/personal-finance backup --if-due
SuccessExitStatus=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/personal-finance /var/backups/personal-finance
