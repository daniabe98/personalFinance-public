PF_DATABASE_URL=sqlite:////var/lib/personal-finance/personal-finance.sqlite3
PF_SECRET_KEY=<replace-with-at-least-32-random-characters>
PF_DOMESTIC_TIMEZONE=Europe/Madrid
PF_BACKUP_RETENTION=14
PF_BACKUP_DIRECTORY=/var/backups/personal-finance
PF_ALLOWED_ORIGIN=https://finance.home.arpa:8443
PF_TLS_CERT=/etc/personal-finance/tls/server.crt
PF_TLS_KEY=/etc/personal-finance/tls/server.key
